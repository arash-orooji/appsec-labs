{
  "Name": "Block-CL-TE-Smuggling",
  "Api": "waf-regional",
  "Note": "AWS WAF Classic: Content-Length present AND Transfer-Encoding contains chunked. LocalStack Community does not support WAFv2 AndStatement.",
  "MetricName": "BlockCLTESmuggling",
  "Predicates": [
    {
      "Negated": false,
      "Type": "SizeConstraint",
      "SizeConstraintSet": {
        "Name": "Content-Length-Present",
        "SizeConstraints": [
          {
            "FieldToMatch": { "Type": "HEADER", "Data": "content-length" },
            "TextTransformation": "NONE",
            "ComparisonOperator": "GE",
            "Size": 0
          }
        ]
      }
    },
    {
      "Negated": false,
      "Type": "ByteMatch",
      "ByteMatchSet": {
        "Name": "TE-Chunked",
        "ByteMatchTuples": [
          {
            "FieldToMatch": { "Type": "HEADER", "Data": "transfer-encoding" },
            "TargetString": "chunked",
            "TextTransformation": "LOWERCASE",
            "PositionalConstraint": "CONTAINS"
          }
        ]
      }
    }
  ],
  "Action": "BLOCK"
}

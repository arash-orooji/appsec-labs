{
  "Name": "Block-Malformed-Content-Length",
  "Api": "waf-regional",
  "Note": "AWS WAF Classic ByteMatch on Content-Length containing a comma. LocalStack Community does not support WAFv2 OrStatement.",
  "MetricName": "BlockMalformedContentLength",
  "Predicates": [
    {
      "Negated": false,
      "Type": "ByteMatch",
      "ByteMatchSet": {
        "Name": "Malformed-Content-Length",
        "ByteMatchTuples": [
          {
            "FieldToMatch": { "Type": "HEADER", "Data": "content-length" },
            "TargetString": ",",
            "TextTransformation": "NONE",
            "PositionalConstraint": "CONTAINS"
          }
        ]
      }
    }
  ],
  "Action": "BLOCK"
}

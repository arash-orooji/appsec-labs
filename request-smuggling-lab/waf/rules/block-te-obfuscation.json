{
  "Name": "Block-TE-Obfuscation",
  "Api": "waf-regional",
  "Note": "AWS WAF Classic ByteMatchSet is OR across tuples. LocalStack Community does not support WAFv2 OrStatement.",
  "MetricName": "BlockTEObfuscation",
  "Predicates": [
    {
      "Negated": false,
      "Type": "ByteMatch",
      "ByteMatchSet": {
        "Name": "TE-Obfuscation",
        "ByteMatchTuples": [
          {
            "FieldToMatch": { "Type": "HEADER", "Data": "transfer-encoding" },
            "TargetString": "identity",
            "TextTransformation": "LOWERCASE",
            "PositionalConstraint": "CONTAINS"
          },
          {
            "FieldToMatch": { "Type": "HEADER", "Data": "transfer-encoding" },
            "TargetString": "chunked,",
            "TextTransformation": "LOWERCASE",
            "PositionalConstraint": "CONTAINS"
          },
          {
            "FieldToMatch": { "Type": "HEADER", "Data": "transfer-encoding" },
            "TargetString": ",chunked",
            "TextTransformation": "LOWERCASE",
            "PositionalConstraint": "CONTAINS"
          },
          {
            "FieldToMatch": { "Type": "HEADER", "Data": "transfer-encoding" },
            "TargetString": "xchunked",
            "TextTransformation": "LOWERCASE",
            "PositionalConstraint": "CONTAINS"
          }
        ]
      }
    }
  ],
  "Action": "BLOCK"
}

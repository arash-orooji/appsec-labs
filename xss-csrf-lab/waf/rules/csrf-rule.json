{
  "Name": "Block-CSRF-Rule",
  "Api": "waf-regional",
  "Note": "AWS WAF Classic rule: POST AND URI /update-email AND NOT Origin starting with the lab origin. LocalStack Community does not support WAFv2 AndStatement/NotStatement.",
  "MetricName": "BlockCSRFRule",
  "Predicates": [
    {
      "Negated": false,
      "Type": "ByteMatch",
      "ByteMatchSet": {
        "Name": "HTTP-POST-Method",
        "ByteMatchTuples": [
          {
            "FieldToMatch": { "Type": "METHOD" },
            "TargetString": "POST",
            "TextTransformation": "NONE",
            "PositionalConstraint": "EXACTLY"
          }
        ]
      }
    },
    {
      "Negated": false,
      "Type": "ByteMatch",
      "ByteMatchSet": {
        "Name": "Update-Email-URI",
        "ByteMatchTuples": [
          {
            "FieldToMatch": { "Type": "URI" },
            "TargetString": "/update-email",
            "TextTransformation": "LOWERCASE",
            "PositionalConstraint": "CONTAINS"
          }
        ]
      }
    },
    {
      "Negated": true,
      "Type": "ByteMatch",
      "ByteMatchSet": {
        "Name": "Legitimate-Origin",
        "ByteMatchTuples": [
          {
            "FieldToMatch": { "Type": "HEADER", "Data": "origin" },
            "TargetString": "http://localhost:3000",
            "TextTransformation": "LOWERCASE",
            "PositionalConstraint": "STARTS_WITH"
          },
          {
            "FieldToMatch": { "Type": "HEADER", "Data": "origin" },
            "TargetString": "http://localhost:8080",
            "TextTransformation": "LOWERCASE",
            "PositionalConstraint": "STARTS_WITH"
          }
        ]
      }
    }
  ],
  "Action": "BLOCK"
}

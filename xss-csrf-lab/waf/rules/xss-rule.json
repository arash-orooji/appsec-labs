{
  "Name": "Block-XSS-Rule",
  "Api": "waf-regional",
  "Note": "AWS WAF Classic XssMatchSet. LocalStack Community does not support WAFv2 XssMatchStatement.",
  "MetricName": "BlockXSSRule",
  "Predicates": [
    {
      "Negated": false,
      "Type": "XssMatch",
      "XssMatchSet": {
        "Name": "XSS-Query-Uri-Body",
        "XssMatchTuples": [
          { "FieldToMatch": { "Type": "QUERY_STRING" }, "TextTransformation": "URL_DECODE" },
          { "FieldToMatch": { "Type": "URI" }, "TextTransformation": "URL_DECODE" },
          { "FieldToMatch": { "Type": "BODY" }, "TextTransformation": "URL_DECODE" }
        ]
      }
    }
  ],
  "Action": "BLOCK"
}
